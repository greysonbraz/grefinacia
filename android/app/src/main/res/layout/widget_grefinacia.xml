<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/w_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="14dp"
    android:background="@drawable/widget_bg">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Grefinacia"
        android:textColor="#A78BFA"
        android:textSize="12sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/w_free_label"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:text="Livre para gastar"
        android:textColor="#A1A1AA"
        android:textSize="12sp" />

    <TextView
        android:id="@+id/w_free"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Abra o app"
        android:textColor="#F8FAFC"
        android:textSize="22sp"
        android:textStyle="bold"
        android:maxLines="1" />

    <TextView
        android:id="@+id/w_balance"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:textColor="#F8FAFC"
        android:textSize="13sp"
        android:maxLines="1" />

    <TextView
        android:id="@+id/w_next"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textColor="#A1A1AA"
        android:textSize="12sp"
        android:maxLines="1"
        android:ellipsize="end" />

    <TextView
        android:id="@+id/w_updated"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:textColor="#6B6680"
        android:textSize="10sp" />
</LinearLayout>
